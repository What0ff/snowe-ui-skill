CODEX.md
**/CODEX.md
GEMINI.md
**/GEMINI.md
.cursor/
**/.cursor/
.windsurf/
**/.windsurf/
.roo/
**/.roo/

# Exact public exceptions: installable metadata and one repository-maintenance
# skill. Other .agents content remains local unless deliberately allowlisted.
!/skill/snowe-ui-skill/agents/
!/skill/snowe-ui-skill/agents/openai.yaml
!/.agents/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/atlas-maintainer/
!/.agents/skills/atlas-maintainer/**

# Maintainer-local task/session state and generated working context.
work/
outputs/
logs/
generated-context/
generated_context/
CURRENT_TASK.md
**/CURRENT_TASK.md
PROJECT-MEMORY.md
**/PROJECT-MEMORY.md
