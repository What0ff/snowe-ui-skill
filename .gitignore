# Durable repository guidance is public. These negations also override broad
# workstation-level AI ignores for repository-scoped contributor instructions.
!/AGENTS.md
!**/AGENTS.md
!/.github/copilot-instructions.md
!/.github/instructions/
!/.github/instructions/**
!/.github/prompts/
!/.github/prompts/**
!/docs/atlas/
!/docs/atlas/**
!/scripts/atlas/
!/scripts/atlas/**
!/scripts/check_contributor_context.py

# Maintainer-local agent/runtime configuration remains private.
agents/
**/agents/
.agents/
**/.agents/
.codex/
**/.codex/
.openai/
**/.openai/
.claude/
**/.claude/
.gemini/
**/.gemini/
.continue/
