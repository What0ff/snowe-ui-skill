{
  "schema": "1.1",
  "title": "Order orchestration hub",
  "desc": "Records, contracts and apps feed the Relay Supply office, which hands work to the orchestrator core. The core dispatches intake, billing and dispatch agents, and the dashboard reports resolved orders. The highlighted path follows a contract through billing.",
  "id_prefix": "hub2-",
  "style": "technical",
  "unit": 34,
  "icons": {
    "intake": "icons/outline/intake.svg",
    "billing": "icons/outline/billing.svg",
    "dispatch": "icons/outline/dispatch.svg",
    "hub": "icons/outline/hub.svg"
  },
  "objects": [
    {"id": "floor", "type": "ground-grid", "x": -2, "y": -4, "w": 21, "d": 19, "step": 1, "pattern": "mesh"},

    {"id": "records", "type": "tile", "x": 0.8, "y": -0.9, "w": 2.0, "d": 2.0, "glyph": "database", "label": "Records", "role": "source", "order": 0},
    {"id": "contracts", "type": "tile", "x": 0.8, "y": 1.7, "w": 2.0, "d": 2.0, "glyph": "docs", "label": "Contracts", "role": "source", "order": 0},
    {"id": "apps", "type": "tile", "x": 0.8, "y": 4.3, "w": 2.0, "d": 2.0, "glyph": "apps", "label": "Apps", "role": "source", "order": 0},

    {"id": "plaza", "type": "slab", "x": 0.2, "y": 8.0, "w": 6.2, "d": 5.6, "h": 0.2, "radius": 0.12, "inset": 0.22, "role": "site", "order": 1},
    {"id": "tower", "type": "building", "x": 0.8, "y": 8.6, "z": 0.2, "w": 2.2, "d": 2.2, "floors": 9, "floor_h": 0.48, "windows": "curtain", "roof_unit": true, "role": "office", "order": 1},
    {"id": "office", "type": "building", "x": 3.0, "y": 8.8, "z": 0.2, "w": 2.8, "d": 3.2, "floors": 3, "floor_h": 0.62, "windows": "bands", "entrance": "x+", "sign": "Relay Supply", "role": "office", "order": 1},
    {"id": "grove-front", "type": "trees", "x": 0.8, "y": 12.4, "z": 0.2, "w": 4.6, "d": 1.0, "count": 4, "size": 0.62, "planter": true},
    {"id": "grove-side", "type": "trees", "x": 5.6, "y": 12.1, "z": 0.2, "w": 0.7, "d": 1.4, "count": 2, "size": 0.6, "planter": true},

    {"id": "core", "type": "core", "x": 6.6, "y": 4.4, "w": 4.4, "d": 4.4, "h": 0.34, "layers": 2, "spacing": 1.05, "icon": "hub", "label": "Orchestrator", "role": "core", "order": 2},

    {"id": "intake", "type": "tile", "x": 12.0, "y": -2.4, "w": 1.3, "d": 4.6, "h": 0.55, "radius": 0.26, "layout": "row", "label_axis": "y", "icon": "intake", "label": "Intake agent", "label_size": 12, "role": "agent", "order": 3},
    {"id": "billing", "type": "tile", "x": 13.75, "y": -2.4, "w": 1.3, "d": 4.6, "h": 0.55, "radius": 0.26, "layout": "row", "label_axis": "y", "icon": "billing", "label": "Billing agent", "label_size": 12, "role": "agent", "order": 3, "accent": true},
    {"id": "dispatch", "type": "tile", "x": 15.5, "y": -2.4, "w": 1.3, "d": 4.6, "h": 0.55, "radius": 0.26, "layout": "row", "label_axis": "y", "icon": "dispatch", "label": "Dispatch agent", "label_size": 12, "role": "agent", "order": 3},

    {"id": "board", "type": "dashboard", "x": 15.2, "y": 9.0, "w": 5.0, "h": 3.4, "orient": "x+", "label": "Resolved today", "label_size": 12, "chart": "both", "rows": 3, "role": "report", "order": 4},

    {"type": "connector", "from": "records", "to": "core", "from_side": "x+", "start": "port", "end": "none", "order": 1},
    {"type": "connector", "from": "contracts", "to": "plaza", "from_side": "x+", "to_side": "y-", "to_offset": 0.8, "start": "port", "end": "none", "accent": true, "order": 1},
