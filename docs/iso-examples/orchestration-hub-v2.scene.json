    {"type": "connector", "from": "core", "to": "intake", "from_side": "y-", "to_side": "y+", "from_offset": -0.8, "via": [[12.65, 2.9]], "to_z": 0.27, "end": "port", "order": 3},
    {"type": "connector", "from": "core", "to": "billing", "from_side": "y-", "to_side": "y+", "from_offset": 0.2, "via": [[14.4, 3.4]], "to_z": 0.27, "end": "port", "accent": true, "order": 3},
    {"type": "connector", "from": "core", "to": "dispatch", "from_side": "y-", "to_side": "y+", "from_offset": 1.2, "via": [[16.15, 3.9]], "to_z": 0.27, "end": "port", "order": 3}
  ]
