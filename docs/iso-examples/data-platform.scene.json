    {"id": "ingest", "type": "stack", "x": 3.4, "y": 7.3, "w": 2, "d": 2, "count": 4, "label": "Ingest", "role": "ingest", "order": 1, "accent": true},

    {"id": "core-pad", "type": "slab", "x": 6.9, "y": 5.9, "w": 4.8, "d": 4.8, "h": 0.3, "radius": 0.45, "inset": 0.35, "role": "core-group", "order": 2},
