    {"type": "connector", "from": "team", "to": "hub-pad", "start": "dot", "accent": true, "order": 1},
    {"type": "connector", "from": "hub-pad", "to": "research", "from_side": "y-", "to_side": "y+", "order": 2},
    {"type": "connector", "from": "hub-pad", "to": "code", "from_side": "y-", "to_side": "y+", "accent": true, "order": 2},
    {"type": "connector", "from": "hub-pad", "to": "review", "from_side": "y-", "to_side": "y+", "order": 2},
    {"type": "connector", "from": "hub-pad", "to": "report", "order": 3}
  ]
