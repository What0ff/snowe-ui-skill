    {"id": "hub-pad", "type": "slab", "x": 5.0, "y": 4.6, "w": 6.9, "d": 6.0, "h": 0.3, "radius": 0.5, "inset": 0.45, "role": "hub-group", "order": 1},
    {"id": "orchestrator", "type": "chip", "x": 6.45, "y": 5.6, "z": 0.3, "w": 4.0, "d": 4.0, "h": 0.38, "label": "Orchestrator", "label_size": 11, "role": "core", "order": 1, "accent": true},

    {"id": "research", "type": "card", "x": 4.1, "y": 0.6, "w": 2.5, "h": 1.5, "orient": "y+", "t": 0.14, "glyph": "user", "label": "Research", "lines": 2, "role": "agent", "order": 2},
    {"id": "code", "type": "card", "x": 7.2, "y": 0.6, "w": 2.5, "h": 1.5, "orient": "y+", "t": 0.14, "glyph": "user", "label": "Code", "lines": 2, "role": "agent", "order": 2, "accent": true},
    {"id": "review", "type": "card", "x": 10.3, "y": 0.6, "w": 2.5, "h": 1.5, "orient": "y+", "t": 0.14, "glyph": "user", "label": "Review", "lines": 2, "role": "agent", "order": 2},

