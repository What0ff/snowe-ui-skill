        {"type": "rounded-rect", "id": "lid", "x": 7, "y": 3.5, "w": 10, "h": 3, "radius": 1.5},
        {"type": "polyline", "id": "check", "points": [[9, 15], [11, 17], [15, 13]], "radius": 0, "role": "detail"}
      ]
