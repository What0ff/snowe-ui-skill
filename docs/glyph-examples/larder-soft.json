      "keyline": "square",
      "shapes": [
        {"type": "line", "id": "lid", "from": [3.5, 6.5], "to": [20.5, 6.5]},
        {"type": "polyline", "id": "handle", "points": [[9, 6.5], [9, 4], [15, 4], [15, 6.5]], "radius": 1},
