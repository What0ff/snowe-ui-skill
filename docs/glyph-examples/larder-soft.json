      "keyline": "square",
      "shapes": [
        {"type": "arrow", "id": "arrow", "from": [12, 3.5], "to": [12, 15], "head": 4},
        {"type": "polyline", "id": "tray", "points": [[4, 14.5], [4, 20], [20, 20], [20, 14.5]], "duotone_fill": true}
      ]
    },
    {
      "name": "trash",
