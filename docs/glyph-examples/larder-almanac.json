{
  "schema": "1.0",
  "family": "larder-almanac",
  "tokens": {
    "grid": 24,
    "padding": 2,
    "stroke": 1.75,
    "linecap": "butt",
    "linejoin": "miter",
    "radius": 1.5,
    "detail": "medium",
    "dot": 2,
    "secondary_opacity": 0.18,
    "terminal": "angled",
    "terminal_angle": 45,
    "contrast": 0.65,
    "corner": "sharp",
    "proportion": "narrow"
  },
  "target_sizes": [16, 20, 24, 32],
  "metadata": {
    "creator": "Snowe glyph.py demo (Larder recipe and pantry app, editorial almanac voice)",
    "reviewed": "2026-11-15",
    "license": "project-owned demo family"
  },
  "sheet": {"tabs": ["home", "search", "calendar", "bell", "user"]},
  "glyphs": [
    {
      "name": "home",
      "role": "go to the Larder home screen",
      "keyline": "square",
      "shapes": [
        {"type": "path", "id": "house", "d": "M4.5 11.5 L12 3.5 L19.5 11.5 V20.75 H14.5 V15.25 H9.5 V20.75 H4.5 Z"}
      ]
    },
    {
      "name": "search",
      "role": "search recipes and pantry items",
      "keyline": "square",
      "shapes": [
        {"type": "circle", "id": "lens", "center": [10.5, 10], "r": 6.25},
        {"type": "line", "id": "handle", "from": [15, 14.5], "to": [19.5, 20]},
        {"type": "arc", "id": "glint", "center": [10.5, 10], "r": 3.25, "start": 195, "end": 255, "role": "detail", "min_detail": "medium"}
      ]
    },
    {
      "name": "settings",
