        {"type": "gear", "id": "cog", "center": [12, 12], "r": 9, "root": 7, "teeth": 8, "tooth": 0.34},
        {"type": "circle", "id": "hub", "center": [12, 12], "r": 3, "role": "detail"}
      ]
    },
    {
      "name": "user",
      "role": "open the cook's profile",
      "keyline": "square",
      "shapes": [
        {"type": "circle", "id": "head", "center": [12, 7], "r": 4},
        {"type": "path", "id": "shoulders", "d": "M5.25 21 A6.75 6.75 0 0 1 18.75 21", "role": "body"}
      ]
    },
    {
      "name": "bell",
      "role": "show reminders and notifications",
      "keyline": "square",
