    {
      "name": "scale-servings",
      "role": "scale a recipe's servings up or down",
      "keyline": "square",
      "shapes": [
        {"type": "path", "id": "bowl", "d": "M4.5 12.25 H19.5 A7.5 7.5 0 0 1 4.5 12.25 Z"},
        {"type": "line", "id": "middle-rim", "from": [6.5, 9], "to": [17.5, 9]},
        {"type": "line", "id": "top-rim", "from": [8.5, 5.75], "to": [15.5, 5.75]}
      ]
    },
    {
      "name": "pantry-stocked",
      "role": "mark an ingredient as already in the pantry",
      "keyline": "portrait",
      "shapes": [
        {"type": "rounded-rect", "id": "jar", "x": 5.5, "y": 9.25, "w": 13, "h": 11.75},
        {"type": "line", "id": "lid", "from": [8, 5.5], "to": [16, 5.5]},
        {"type": "polyline", "id": "check", "points": [[9.25, 15.25], [11.25, 17.25], [14.75, 13.25]], "radius": 0, "role": "detail"}
      ]
    }
