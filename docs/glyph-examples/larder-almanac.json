      ]
    },
    {
      "name": "download",
      "role": "keep a recipe for offline cooking",
      "keyline": "square",
      "shapes": [
        {"type": "arrow", "id": "arrow", "from": [12, 3.25], "to": [12, 15.5], "head": 4},
        {"type": "polyline", "id": "tray", "points": [[4.75, 14.5], [4.75, 20.75], [19.25, 20.75], [19.25, 14.5]], "duotone_fill": true}
      ]
    },
    {
      "name": "trash",
      "role": "delete a recipe",
      "keyline": "square",
      "shapes": [
        {"type": "line", "id": "lid", "from": [4, 6.5], "to": [20, 6.5]},
        {"type": "polyline", "id": "handle", "points": [[9.5, 6.5], [9.5, 3.75], [14.5, 3.75], [14.5, 6.5]], "radius": 1},
        {"type": "polyline", "id": "bin", "points": [[6, 6.5], [7, 20.75], [17, 20.75], [18, 6.5]], "role": "body"},
