      "shapes": [
        {"type": "rounded-rect", "id": "jar", "x": 5, "y": 8, "w": 14, "h": 12},
        {"type": "line", "id": "lid", "from": [8, 4], "to": [16, 4]},
        {"type": "polyline", "id": "check", "points": [[9, 14.5], [11, 16.5], [15, 12.5]], "radius": 0, "role": "detail"}
