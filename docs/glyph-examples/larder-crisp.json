      "shapes": [
        {"type": "line", "id": "lid", "from": [3.5, 7], "to": [20.5, 7]},
        {"type": "polyline", "id": "handle", "points": [[9, 7], [9, 4], [15, 4], [15, 7]], "radius": 0},
        {"type": "polyline", "id": "bin", "points": [[5.5, 7], [6.5, 20], [17.5, 20], [18.5, 7]], "role": "body"},
